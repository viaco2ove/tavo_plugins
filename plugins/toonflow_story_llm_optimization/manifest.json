{
  "id": "com.toonflow.llm-optimization",
  "name": "Toonflow-群聊-LLM优化器",
  "version": "1.1.0",
  "description": "完全接管 LLM 接口调用：对齐 toonflow-game，支持 MiniMax/SiliconFlow/DashScope 等适配器直接 fetch",
  "author": "viaco",
  "minAppVersion": "1.0.0",
  "entry": "entry.js",
  "permissions": ["generate", "variable", "chat"],
  "htmlFragments": [
    {
      "path": "ui/llm_panel.html",
      "position": "/chat/body/end"
    }
  ],
  "settings": [
    {
      "key": "apiKey",
      "type": "string",
      "label": "API Key",
      "default": ""
    },
    {
      "key": "apiUrl",
      "type": "string",
      "label": "API 地址（如 https://api.minimaxi.com）",
      "default": ""
    },
    {
      "key": "model",
      "type": "string",
      "label": "模型名",
      "default": ""
    },
    {
      "key": "reasoningEffort",
      "type": "select",
      "label": "思考程度",
      "options": ["none", "minimal", "low", "medium", "high"],
      "default": "minimal"
    },
    {
      "key": "temperature",
      "type": "slider",
      "label": "Temperature",
      "default": 0.3,
      "min": 0,
      "max": 2,
      "step": 0.1
    },
    {
      "key": "topP",
      "type": "slider",
      "label": "Top-P",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    {
      "key": "maxTokens",
      "type": "slider",
      "label": "回复令牌限制",
      "default": 1500,
      "min": 100,
      "max": 4000,
      "step": 100
    }
  ]
}