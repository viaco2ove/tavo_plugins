{
  "specVersion": 2,
  "id": "com.toonflow.llm-optimization",
  "name": {
    "$t": "plugin.name"
  },
  "version": "1.1.9",
  "description": {
    "$t": "plugin.description"
  },
  "author": "viaco",
  "minAppVersion": "1.0.0",
  "entry": "entry.js",
  "permissions": [
    "generate",
    "variable",
    "chat"
  ],
  "localization": {
    "defaultLocale": "zh-CN",
    "resources": {
      "en": "locales/en.json",
      "zh-CN": "locales/zh-CN.json"
    }
  },
  "contributes": {
    "settings": {
      "schema": [
        {
          "key": "apiKey",
          "type": "text",
          "label": {
            "$t": "settings.apiKey"
          },
          "default": ""
        },
        {
          "key": "apiUrl",
          "type": "text",
          "label": {
            "$t": "settings.apiUrl"
          },
          "default": ""
        },
        {
          "key": "model",
          "type": "text",
          "label": {
            "$t": "settings.model"
          },
          "default": ""
        },
        {
          "key": "reasoningEffort",
          "type": "select",
          "label": {
            "$t": "settings.reasoningEffort"
          },
          "options": [
            {
              "value": "none",
              "label": "none"
            },
            {
              "value": "minimal",
              "label": "minimal"
            },
            {
              "value": "low",
              "label": "low"
            },
            {
              "value": "medium",
              "label": "medium"
            },
            {
              "value": "high",
              "label": "high"
            }
          ],
          "default": "minimal"
        },
        {
          "key": "temperature",
          "type": "slider",
          "label": {
            "$t": "settings.temperature"
          },
          "default": 0.3,
          "min": 0,
          "max": 2,
          "step": 0.1
        },
        {
          "key": "topP",
          "type": "slider",
          "label": {
            "$t": "settings.topP"
          },
          "default": 0.5,
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        {
          "key": "maxTokens",
          "type": "slider",
          "label": {
            "$t": "settings.maxTokens"
          },
          "default": 1500,
          "min": 100,
          "max": 4000,
          "step": 100
        }
      ]
    }
  }
}