{
  "specVersion": 2,
  "id": "com.toonflow.llm-optimization",
  "name": {
    "$t": "plugin.name"
  },
  "version": "1.0.0",
  "minAppVersion": "1.0.0",
  "entry": "entry.js",
  "author": "viaco",
  "description": {
    "$t": "plugin.description"
  },
  "localization": {
    "defaultLocale": "zh-CN",
    "resources": {
      "en": "locales/en.json",
      "zh-CN": "locales/zh-CN.json"
    }
  },
  "cover": "cover.png",
  "permissions": [
    "generate",
    "variable",
    "chat"
  ],
  "contributes": {
    "htmlFragments": [
      {
        "id": "llm-opt-panel",
        "src": "ui/llm_panel.html",
        "mount": "/chat/body/end"
      }
    ],
    "settings": {
      "schema": [
        {
          "type": "info",
          "text": {
            "$t": "settings.info"
          },
          "icon": "info"
        },
        {
          "key": "enabled",
          "type": "switch",
          "label": {
            "$t": "settings.enabled"
          },
          "default": true
        },
        {
          "key": "reasoningEffort",
          "type": "select",
          "label": {
            "$t": "settings.reasoningEffort"
          },
          "default": "minimal",
          "options": [
            { "value": "none", "label": "关闭思考 (none)" },
            { "value": "minimal", "label": "最小思考 (minimal) — 推荐" },
            { "value": "low", "label": "低思考 (low)" },
            { "value": "medium", "label": "中等思考 (medium)" },
            { "value": "high", "label": "高思考 (high)" }
          ]
        },
        {
          "key": "temperature",
          "type": "slider",
          "label": {
            "$t": "settings.temperature"
          },
          "default": 0.3,
          "min": 0,
          "max": 2,
          "step": 0.1
        },
        {
          "key": "topP",
          "type": "slider",
          "label": {
            "$t": "settings.topP"
          },
          "default": 0.5,
          "min": 0,
          "max": 1,
          "step": 0.05
        }
      ]
    }
  }
}
