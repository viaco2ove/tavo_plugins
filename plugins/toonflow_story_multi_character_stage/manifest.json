{
  "specVersion": 2,
  "id": "com.toonflow.multi-character-stage",
  "name": {
    "$t": "plugin.name"
  },
  "version": "2.0.0",
  "minAppVersion": "1.0.0",
  "entry": "entry.js",
  "author": "viaco",
  "description": {
    "$t": "plugin.description"
  },
  "localization": {
    "defaultLocale": "zh-CN",
    "resources": {
      "en": "locales/en.json",
      "zh-CN": "locales/zh-CN.json"
    }
  },
  "cover": "cover.png",
  "permissions": [
    "input",
    "message",
    "generate",
    "variable",
    "chat"
  ],
  "contributes": {
    "sidebar": [
      {
        "id": "mcs-toggle",
        "label": {
          "$t": "sidebar.toggle"
        }
      },
      {
        "id": "mcs-area",
        "label": {
          "$t": "sidebar.area"
        }
      }
    ],
    "htmlFragments": [
      {
        "id": "mcs-orchestration-panel",
        "src": "ui/orchestration_panel.html",
        "mount": "/chat/body/end"
      }
    ],
    "settings": {
      "schema": [
        {
          "type": "info",
          "text": {
            "$t": "settings.info"
          },
          "icon": "info"
        },
        {
          "key": "enabled",
          "type": "switch",
          "label": {
            "$t": "settings.enabled"
          },
          "default": true
        },
        {
          "key": "responseMode",
          "type": "select",
          "label": {
            "$t": "settings.responseMode"
          },
          "default": "scenario",
          "options": [
            {
              "value": "scenario",
              "label": "场景模式（NPC优先编排）"
            },
            {
              "value": "natural",
              "label": "自然模式"
            }
          ]
        },
        {
          "key": "showPanel",
          "type": "switch",
          "label": {
            "$t": "settings.showPanel"
          },
          "default": true
        }
      ]
    }
  }
}
