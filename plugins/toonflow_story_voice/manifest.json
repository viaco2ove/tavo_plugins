{
  "specVersion": 2,
  "id": "com.toonflow.story-voice",
  "name": {
    "$t": "plugin.name"
  },
  "version": "0.1.11",
  "entry": "entry.js",
  "description": {
    "$t": "plugin.description"
  },
  "author": "viaco",
  "minAppVersion": "1.0.0",
  "permissions": [
    "file",
    "variable",
    "message",
    "chat",
    "tts"
  ],
  "localization": {
    "defaultLocale": "zh-CN",
    "resources": {
      "en": "locales/en.json",
      "zh-CN": "locales/zh-CN.json"
    }
  },
  "contributes": {
    "settings": {
      "schema": [
        {
          "key": "voice_platform",
          "type": "select",
          "label": {
            "$t": "settings.voice_platform"
          },
          "options": [
            {
              "value": "xiaomimimo",
              "label": "xiaomimimo"
            },
            {
              "value": "aliyun",
              "label": "aliyun"
            },
            {
              "value": "tavo",
              "label": "tavo"
            }
          ],
          "default": "xiaomimimo"
        },
        {
          "key": "voice_platform_apikey",
          "type": "text",
          "label": {
            "$t": "settings.voice_platform_apikey"
          },
          "default": ""
        },
        {
          "key": "auto_play",
          "type": "switch",
          "label": {
            "$t": "settings.auto_play"
          },
          "default": true
        }
      ]
    }
  }
}