{
  "specVersion": 2,
  "id": "com.toonflow.story-event-manager",
  "name": {
    "$t": "plugin.name"
  },
  "version": "1.2.3",
  "minAppVersion": "1.0.0",
  "entry": "entry.js",
  "author": "viaco",
  "description": {
    "$t": "plugin.description"
  },
  "localization": {
    "defaultLocale": "zh-CN",
    "resources": {
      "en": "locales/en.json",
      "zh-CN": "locales/zh-CN.json"
    }
  },
  "cover": "cover.png",
  "permissions": [
    "input",
    "message",
    "generate",
    "variable",
    "lorebook",
    "chat",
    "character",
    "persona",
    "file"
  ],
  "contributes": {
    "htmlFragments": [
      {
        "id": "tf-story-trigger",
        "src": "ui/story_panel.html",
        "mount": "/chat/body/end"
      }
    ],
    "settings": {
      "schema": [
        {
          "type": "info",
          "text": {
            "$t": "settings.info"
          },
          "icon": "info"
        },
        {
          "key": "enabled",
          "type": "switch",
          "label": {
            "$t": "settings.enabled"
          },
          "default": true
        },
        {
          "key": "useCustomOrchestration",
          "type": "switch",
          "label": {
            "$t": "settings.orchestration"
          },
          "default": true
        },
        {
          "type": "info",
          "text": {
            "$t": "settings.orchestrationHint"
          },
          "icon": "info"
        }
      ]
    }
  }
}