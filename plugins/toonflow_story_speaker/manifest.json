{
  "specVersion": 2,
  "id": "com.toonflow.story-speaker",
  "name": {
    "$t": "plugin.name"
  },
  "version": "2.0.5",
  "minAppVersion": "1.0.0",
  "entry": "entry.js",
  "author": "viaco",
  "description": {
    "$t": "plugin.description"
  },
  "localization": {
    "defaultLocale": "zh-CN",
    "resources": {
      "en": "locales/en.json",
      "zh-CN": "locales/zh-CN.json"
    }
  },
  "cover": "cover.png",
  "permissions": [
    "input",
    "message",
    "generate",
    "variable",
    "chat",
    "character"
  ],
  "contributes": {
    "sidebar": [
      {
        "id": "speaker-test",
        "label": {
          "$t": "sidebar.test"
        }
      },
      {
        "id": "speaker-char",
        "label": {
          "$t": "sidebar.char"
        }
      }
    ],
    "settings": {
      "schema": [
        {
          "type": "info",
          "text": {
            "$t": "settings.info"
          },
          "icon": "info"
        },
        {
          "key": "enabled",
          "type": "switch",
          "label": {
            "$t": "settings.enabled"
          },
          "default": true
        },
        {
          "key": "temperature",
          "type": "slider",
          "label": {
            "$t": "settings.temperature"
          },
          "min": 0.1,
          "max": 1.5,
          "step": 0.1,
          "default": 0.7
        },
        {
          "key": "maxTokens",
          "type": "slider",
          "label": {
            "$t": "settings.maxTokens"
          },
          "min": 50,
          "max": 500,
          "step": 50,
          "default": 220
        }
      ]
    }
  }
}